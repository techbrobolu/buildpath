{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
			"@/types": ["./src/types"],
			"@/constants": ["./src/constants"]
		}
  },
  "include": [
    "./src/**/*"
  ]
}
