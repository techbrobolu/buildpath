{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"skipLibCheck": true,
		"paths": {
			"@": ["./src"],
			"@/index": ["./src/index"],
			"@/types": ["./src/types"],
			"@/sample-data": ["./src/utils/sample-data"]
		}
	},
	"include": ["./src/**/*"]
}
