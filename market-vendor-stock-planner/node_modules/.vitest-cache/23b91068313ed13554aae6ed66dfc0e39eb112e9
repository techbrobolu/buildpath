const groupByProduct = (sales) => {
	return sales.reduce((groups, sale) => {
		const key = sale.productName;
		if (!groups[key]) {
			groups[key] = [];
		};
		groups[key].push(sale);
		return groups;
	}, {});
};
const getAverageSold = (groupedSales) => {
	let averageSold = {};
	Object.keys(groupedSales).forEach((key) => {
		let totalSold = groupedSales[key].reduce((prev, amount) => prev + amount.amountSold, 0);
		averageSold[key] = totalSold / groupedSales[key].length;
	});
	return averageSold;
};

